# Salin file ini jadi `.env.local`, lalu isi API key-nya.
#   cp .env.example .env.local
#
# Ambil key gratis di https://aistudio.google.com/apikey
# (tidak perlu kartu kredit — free tier otomatis aktif)
GEMINI_API_KEY=

# Nama aplikasi yang tampil di UI.
NEXT_PUBLIC_APP_NAME=DOCX Editor AI POC

# Opsional — timpa model yang dipakai tanpa mengubah kode.
# Berguna kalau model default dihentikan Google (gejalanya: error 404
# "no longer available to new users").
# Lihat model yang aktif untuk key kamu:
#   curl -s "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY"
# GEMINI_MODEL=gemini-3.6-flash
